        {
          "name": "Webhook without a shop header",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{app_url}}/webhooks/inventory_levels_update",
              "host": [
                "{{app_url}}"
              ],
              "path": [
                "webhooks",
                "inventory_levels_update"
              ]
            },
            "description": "The inventory payload never names the shop, so the domain travels in a header — and that header is **not** covered by the signature. It is treated as untrusted input and its shape is checked before a single query runs.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inventory_item_id\": 808950810,\n  \"location_id\": 655441491,\n  \"available\": 7\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sign the body correctly, but send no shop header. The signature being",
                  "// valid is exactly what makes this case interesting: it isolates the",
                  "// header check from the signature check.",
                  "const CryptoJS = require('crypto-js');",
                  "",
                  "const raw = pm.variables.replaceIn(pm.request.body.raw);",
                  "pm.request.headers.upsert({",
                  "    key: 'X-Shopify-Hmac-Sha256',",
                  "    value: CryptoJS.HmacSHA256(raw, pm.collectionVariables.get('api_secret'))",
                  "        .toString(CryptoJS.enc.Base64),",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "// Every response uses the same envelope: code, status, message, data.",
                  "pm.test('envelope is intact', () => {",
                  "    pm.expect(body).to.have.all.keys('code', 'status', 'message', 'data');",
                  "    pm.expect(body.code).to.eql(pm.response.code);",
                  "});",
                  "",
