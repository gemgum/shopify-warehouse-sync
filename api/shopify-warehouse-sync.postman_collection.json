    },
    {
      "name": "4 · Must fail",
      "description": "The guards, exercised on purpose. A collection where everything passes proves the happy path works; these prove the doors are actually shut.\n\nEvery request here is expected to be refused. A green run means the service is behaving.",
      "item": [
        {
          "name": "Sync without a token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{app_url}}/sync?shop={{shop}}",
              "host": [
                "{{app_url}}"
              ],
              "path": [
                "sync"
              ],
              "query": [
                {
                  "key": "shop",
                  "value": "{{shop}}"
                }
              ]
            },
            "description": "No `X-Sync-Token`. This address can rewrite a whole store's inventory, so an unauthenticated caller must never get past the header check."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "// Every response uses the same envelope: code, status, message, data.",
                  "pm.test('envelope is intact', () => {",
                  "    pm.expect(body).to.have.all.keys('code', 'status', 'message', 'data');",
                  "    pm.expect(body.code).to.eql(pm.response.code);",
                  "});",
                  "",
                  "pm.test('refused', () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(body.status).to.eql('unauthorized');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Sync with the wrong token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Sync-Token",
                "value": "0000000000000000000000000000000000000000000"
              }
            ],
            "url": {
              "raw": "{{app_url}}/sync?shop={{shop}}",
              "host": [
                "{{app_url}}"
              ],
              "path": [
                "sync"
              ],
              "query": [
                {
                  "key": "shop",
                  "value": "{{shop}}"
                }
              ]
            },
            "description": "A token of the right shape but the wrong value. Compared in constant time — an ordinary comparison leaks how many leading characters were already right, which is enough to guess it piece by piece."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
