# Copy to .env and fill in. The service reads it itself at startup.
#
# ONE RULE: the environment wins, this file only fills in what is empty. If .env
# travels to a server by accident, it cannot override anything.
#
# NEVER commit a .env file. The only one committed is this .env.example.


# ── Required ─────────────────────────────────────────────────────────────────

DATABASE_URL=postgres://postgres:dev@127.0.0.1:55432/shopify_sync?sslmode=disable

# App credentials from the Shopify Partner dashboard → Apps → this app →
# Client credentials.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# This service's public address. **Must be HTTPS** — Shopify refuses a callback
# address that is not, development included.
#
#   cloudflared tunnel --url http://localhost:8080
#
# Then register APP_URL + /auth/callback as an allowed redirection URL in the
# Partner dashboard. One slash apart and the whole install is refused.
APP_URL=https://example.trycloudflare.com

# The secret every caller of POST /sync must carry. At least 32 characters; the
# service refuses to start with anything shorter — that address can rewrite a
# store's entire inventory.
#
#   openssl rand -base64 48
SYNC_TOKEN=


# ── Has a default ────────────────────────────────────────────────────────────

# Permissions requested at install. Adding one forces the merchant to approve
# again.
SHOPIFY_SCOPES=read_products,read_inventory,write_inventory

# The Admin API version. Stated explicitly so moving up is a decision rather
# than a morning surprise — but do keep moving it: Shopify supports each version
# for twelve months, and calls against a retired one stop behaving as written.
SHOPIFY_API_VERSION=2026-07

# Where warehouse stock comes from: a JSON file, or an http(s) address returning
# JSON shaped as {"SKU": quantity}.
WAREHOUSE_SOURCE=warehouse.json

ADDRESS=:8080
READ_TIMEOUT_SECONDS=15
WRITE_TIMEOUT_SECONDS=30
